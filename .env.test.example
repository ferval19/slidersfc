# Proyecto de Supabase DEDICADO a los tests de Playwright. Nunca el mismo
# proyecto que usa producción (slidersfc.vercel.app) ni el de .env.local si
# éste ya es el de producción — ver docs/testing-e2e.md, fase 0.
#
# Copia este fichero a .env.test.local (ya está en .gitignore, junto con
# cualquier .env*.local) y rellena con las claves de ese proyecto de test.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vacío: los tests corren contra localhost.
NEXT_PUBLIC_SITE_URL=
