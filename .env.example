# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Origen público del sitio. En local puede quedarse vacío (se deduce del host).
# En producción: https://slidersfc.app (o el dominio que uses).
NEXT_PUBLIC_SITE_URL=

# Sólo para scripts locales que apliquen migraciones/seed con psql.
# NO se expone al navegador y NO debe subirse al repo.
SUPABASE_DB_URL=
